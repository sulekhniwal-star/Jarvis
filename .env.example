# ==============================================================================
# JARVIS — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env or secret credentials to Git (NFR-SEC-02).
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Local & Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# OpenRouter AI Gateway (Server-Side Only)
OPENROUTER_API_KEY=placeholder-openrouter-key
USD_INR_EXCHANGE_RATE=84.0

# Telegram Bot Integration (Server-Side Only)
TELEGRAM_BOT_TOKEN=placeholder-telegram-token
TELEGRAM_OWNER_CHAT_ID=placeholder-chat-id
OWNER_TELEGRAM_ID=placeholder-chat-id
TELEGRAM_WEBHOOK_SECRET=placeholder-webhook-secret
OWNER_USER_ID=placeholder-owner-uuid

# Environment
NODE_ENV=development

# ==============================================================================
# PROJECT JARVIS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT REAL SECRETS OR VALUES TO REPOSITORIES.
# COPY THIS FILE TO .env AND POPULATE WITH YOUR ACTUAL CONFIGURATION.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development
DEBUG=false
APP_NAME="Project Jarvis"
API_V1_STR=/api/v1

# Master secret key for JWT session signing (generate with: openssl rand -hex 32)
SECRET_KEY=change_me_to_a_secure_random_64_character_hex_string_in_production

# Master 256-bit encryption key for database secrets at rest (Fernet URL-safe base64 key)
# Generate with Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
MASTER_ENCRYPTION_KEY=change_me_to_a_valid_fernet_base64_key_32_bytes_min==

# Token expiry lifetimes (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Single Owner Access Control (Static single-tenant allowlist)
OWNER_USERNAME=jarvis_owner
OWNER_INITIAL_PASSWORD=change_this_strong_password_immediately

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE (SUPABASE / LOCAL POSTGRESQL)
# ------------------------------------------------------------------------------
# Database URL (SQLAlchemy async format: postgresql+psycopg://user:password@host:port/dbname)
# For Supabase: use connection pooling port (6543) or direct port (5432)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jarvis
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_TIMEOUT_SECONDS=30

# Supabase Management API credentials (Optional, for automated pause/resume management)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 3. AI PROVIDER GATEWAY & BUDGET CONTROLS
# ------------------------------------------------------------------------------
# Default Provider: 'mock' (default for testing/CI, ₹0 cost), 'gemini', 'openai'
DEFAULT_AI_PROVIDER=mock

# Hard Budget Circuit Breaker: If false, all paid API calls fail immediately
ALLOW_PAID_API_CALLS=false
MAX_MONTHLY_BUDGET_INR=1000

# Google AI Studio / Gemini API (Optional)
# IMPORTANT: Free tier prompts may be used by Google for model training.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter API Gateway (Optional: multi-provider routing for Gemini, Claude, DeepSeek, etc.)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto

# OpenAI / OpenAI-Compatible (Ollama, Groq, DeepSeek) (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. GITHUB APP INTEGRATION (LEAST PRIVILEGE)
# ------------------------------------------------------------------------------
# GitHub App ID and Client ID
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base64-encoded RSA Private Key (.pem file) for GitHub App authentication
GITHUB_APP_PRIVATE_KEY_BASE64=

# Target GitHub Organization or Username
GITHUB_TARGET_ORG=
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_token

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT INTEGRATION
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Authorized Telegram User ID (Numeric user ID from @userinfobot)
# Messages from any other ID will be silently dropped and logged
AUTHORIZED_TELEGRAM_USER_ID=

# Telegram Operation Mode: 'polling' (default for local/hybrid) or 'webhook'
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/telegram
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_header

# ------------------------------------------------------------------------------
# 6. EXECUTION PLANE & SANDBOX
# ------------------------------------------------------------------------------
# Worker Engine: 'github_actions' (default cloud) or 'docker' (local fallback)
EXECUTION_ENGINE=github_actions

# GitHub Actions Workflow Dispatch repository for runner jobs
GITHUB_RUNNER_REPO=

# Execution Limits
TASK_TIMEOUT_MINUTES=10
MAX_DIAGNOSTIC_RETRIES=3
MAX_CONTAINER_MEMORY_MB=2048
MAX_CONTAINER_CPU=1.5


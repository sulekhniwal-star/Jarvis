{
  "name": "jarvis-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis Autonomous Personal AI Software-Building System",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:gen:types": "supabase gen types typescript --local > packages/database/src/types.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "supabase": "^2.15.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
